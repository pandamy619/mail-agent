      "type": "integer",
      "description": "id письма"
     },
     "folder": {
      "type": "string",
      "description": "папка, из которой взят id; для Входящих не указывать"
     }
    },
    "required": [
     "account",
     "id"
    ]
   }
  }
 },
 {
