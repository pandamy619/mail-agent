   "parameters": {
    "type": "object",
    "properties": {
     "account": {
      "type": "string",
      "description": "имя ящика (mail_info accounts)"
     },
     "folder": {
      "type": "string",
      "description": "trash или spam"
     }
    },
    "required": [
     "account",
     "folder"
    ]
   }
  }
 },
