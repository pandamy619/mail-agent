# Скопируйте этот файл в .env и заполните. Файл .env в .gitignore и в git не попадает.
# В Docker те же переменные передаются через env_file, файл на сервере один и тот же.
# Права на файл: chmod 600 .env — в нём пароли приложений всех ящиков.

# ── Telegram (этап 4) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ── Ящики по IMAP ─────────────────────────────────────────────────────
# Для каждого ящика из config.yaml (поле env) — две переменные:
#   <env>_USER — логин (обычно полный адрес почты)
#   <env>_PASS — ПАРОЛЬ ПРИЛОЖЕНИЯ, не пароль от аккаунта
#
# Где взять пароль приложения:
#   Gmail:  myaccount.google.com → Безопасность → Двухэтапная аутентификация → Пароли приложений
#           (в настройках Gmail должен быть включён IMAP)
#   iCloud: account.apple.com → Вход и безопасность → Пароли приложений (логин — Apple ID)
#   Яндекс: id.yandex.ru → Безопасность → Пароли приложений → Почта
#           (в настройках Почты включить «Доступ по IMAP»)
#   Mail.ru: account.mail.ru → Безопасность → Пароли для внешних приложений

IMAP_GOOGLE_USER=
IMAP_GOOGLE_PASS=

IMAP_ICLOUD_USER=
IMAP_ICLOUD_PASS=

IMAP_YANDEX_USER=
IMAP_YANDEX_PASS=
